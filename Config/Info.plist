<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Частичный Info.plist приложения «Деберц».
  Остальные ключи Xcode генерирует сам из настроек проекта (GENERATE_INFOPLIST_FILE = YES,
  INFOPLIST_KEY_… в project.pbxproj) и сливает с этим файлом. Не повторяйте здесь те ключи.
  UILaunchScreen → UIColorName: экран запуска цвета сукна (Assets.xcassets/LaunchBackground)
  вместо чёрной вспышки.
  UIApplicationSceneManifest → UIApplicationSupportsMultipleScenes = false: на iPad одно окно игры.
  Партия и настройки у приложения одни на все окна, второе окно показывало бы ту же партию.
  Для этого в проекте INFOPLIST_KEY_UIApplicationSceneManifest_Generation = NO: сгенерированный
  манифест (с несколькими окнами) перекрыл бы этот.
  Файл лежит вне папки Deberc/: всё, что внутри неё, Xcode кладёт в ресурсы,
  и второй Info.plist сломал бы сборку («Multiple commands produce Info.plist»).
-->
<plist version="1.0">
<dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
</dict>
</plist>
